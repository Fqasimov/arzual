  "narrative": {
    "northStar": "The Hang Tag and the Swatch Book",
    "overview": "The brand's own hang tag, unfolded to page scale: bone card, sand-gold geometric letters cropped by the edge, one gold cord. The collection is its swatch book: the page is dyed in the colour of the dress in view. The opening has the monogram drawing itself upward like ink, then the sheet is swiped up.",
    "keyCharacteristics": [
      "One family, Jost",
      "Bone ground with sand-gold mark",
      "Page dyed per dress",
      "Square corners, 1px cord lines",
      "Every section one tap from WhatsApp"
    ],
    "rules": [
      {
        "name": "The One Dye Rule",
        "body": "The only saturated colour on the page is the colour of the dress in view.",
        "section": "colors"
      },
      {
        "name": "The Tag Voice Rule",
        "body": "Small spaced capitals belong to cloth, tags and fields; never above a heading.",
